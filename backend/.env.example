# Database (PostgreSQL / Supabase / SQLite for local fallback)
DATABASE_URL=sqlite:///./greenops.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/greenops

# GitHub Secrets
GITHUB_WEBHOOK_SECRET=demo_webhook_secret_for_development_32_chars
GITHUB_TOKEN=ghp_dummy_token_for_testing
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# Electricity Maps API
ELECTRICITY_MAPS_API_KEY=mock_electricity_maps_key
DEFAULT_GRID_REGION=US-EAST
GRID_CACHE_TTL_MINUTES=60

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
PORT=8000
